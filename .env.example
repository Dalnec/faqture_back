# =========================
# App
# =========================
PORT=4000
URLDOCS=http://localhost:4000

# =========================
# PostgreSQL principal (API)
# =========================
DB_NAME=faqturedb
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

# =========================
# Conexiones remotas MySQL + SSH (src/libs/connection.js)
# =========================
# Tunnel general (tsifactur/faqture)
DB_SSH_HOST=example-ssh-host
DB_SSH_USER=example-ssh-user
DB_SSH_PASSWORD=example-ssh-password

# tsifactur
DB_THOST=127.0.0.1
DB_TUSER=root
DB_TPASS=secret
DB_TPORT=3306

# faqture
DB_FHOST=127.0.0.1
DB_FUSER=root
DB_FPASS=secret
DB_FPORT=3306

# pse
DB_PSE_HOST=127.0.0.1
DB_PSE_USER=root
DB_PSE_PASS=secret
DB_PSE_PORT=3306
DB_PSE_SSH_HOST=example-pse-ssh-host
DB_PSE_SSH_PORT=22
DB_PSE_SSH_USER=example-pse-ssh-user
DB_PSE_SSH_KEY_PATH=C:/keys/id_rsa
# DB_TSI_SSH_KEY_PASSPHRASE=

# =========================
# WhatsApp API
# =========================
VERSION=v19.0
PHONE_NUMBER_ID=000000000000000
ACCESS_TOKEN=your_whatsapp_access_token

# =========================
# SUNAT Validation API
# =========================
SUNAT_AUTH_URL=https://api-seguridad.sunat.gob.pe/v1/clientesextranet
SUNAT_VALIDATION_URL=https://api.sunat.gob.pe/v1/contribuyente/contribuyentes
SUNAT_CLIENT_ID=your_sunat_client_id
SUNAT_CLIENT_SECRET=your_sunat_client_secret
SUNAT_SCOPE=https://api.sunat.gob.pe/v1/contribuyente/contribuyentes
SUNAT_ENVIRONMENT=production

# =========================
# Logging y Notificaciones de Errores
# =========================
# Nivel de log: error | warn | info (recomendado: error en producción)
LOG_LEVEL=error

# Telegram — dejar vacío para deshabilitar
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Discord — dejar vacío para deshabilitar
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url
